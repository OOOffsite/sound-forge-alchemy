# Processing Service Dockerfile
# Handles audio processing, stem separation, and ML model operations

FROM node:20-alpine AS base

# Install Python, audio processing tools, and ML dependencies
USER root
RUN apk add --no-cache \
    python3 \
    py3-pip \
    ffmpeg \
    sox \
    build-base \
    libc6-compat \
    gfortran \
    openblas-dev \
    lapack-dev \
    curl \
    git \
    make \
    g++ && \
    addgroup -g 1001 -S soundforge && \
    adduser -S soundforge -u 1001 -G soundforge

# Set service-specific environment variables
ENV SERVICE_NAME=processing \
    PORT=3003

# Set working directory
WORKDIR /app

# Copy package files from the processing service directory
COPY package*.json ./

# Create shared directory and copy shared module (will be mounted as volume in dev)
RUN mkdir -p /app/shared

# Install service-specific dependencies
RUN npm install --force && npm cache clean --force

# Copy service source code from backend/processing
COPY src ./src
COPY config ./config

# Create service-specific directories (as root)
RUN mkdir -p \
    /app/logs \
    /app/models \
    /app/temp \
    /app/output \
    && chown -R soundforge:soundforge /app

# Switch to soundforge user
USER soundforge

# Health check specific to Processing Service
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3003/health || exit 1

# Expose Processing Service port
EXPOSE 3003

# Default production command
CMD ["node", "src/index.js"]


# Development stage
FROM base AS development

# Switch to root for development setup
USER root

# Install development dependencies
RUN npm install && npm cache clean --force

# Install nodemon globally for development
RUN npm install -g nodemon

# Set development permissions
RUN chown -R soundforge:soundforge /app

# Switch back to service user
USER soundforge

# Development environment
ENV NODE_ENV=development

# Development command with auto-reload
CMD ["nodemon", "--watch", "src/", "--ignore", "node_modules/", "--ignore", "logs/", "src/index.js"]


# Production stage
FROM base AS production

# Ensure we're using the service user
USER soundforge

# Production environment
ENV NODE_ENV=production

# Production command
CMD ["node", "src/index.js"]


# GPU-enabled stage for CUDA processing (optional)
FROM base AS gpu

USER root

# Install CUDA dependencies if needed
# Note: This would require a CUDA-enabled base image
# RUN apk add --no-cache \
#     cuda-toolkit \
#     nvidia-ml-py

USER soundforge

# GPU-specific environment variables
ENV CUDA_VISIBLE_DEVICES=all \
    NVIDIA_VISIBLE_DEVICES=all

# GPU command
CMD ["node", "src/index.js"]