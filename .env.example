# Sound Forge Alchemy Environment Variables
# Copy this file to .env and fill in your values

# ===================
# ENVIRONMENT
# ===================
NODE_ENV=development
USE_GPU=false
GPU_COUNT=1

# ===================
# SPOTIFY API
# ===================
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ===================
# SUPABASE (if using)
# ===================
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# ===================
# REDIS
# ===================
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# ===================
# RESOURCE LIMITS (optional)
# ===================
# Frontend
FRONTEND_CPU_LIMIT=0.8
FRONTEND_MEMORY_LIMIT=1G

# API Gateway
API_GATEWAY_CPU_LIMIT=0.5
API_GATEWAY_MEMORY_LIMIT=512M

# Backend Services
SPOTIFY_CPU_LIMIT=0.3
SPOTIFY_MEMORY_LIMIT=256M
DOWNLOAD_CPU_LIMIT=0.5
DOWNLOAD_MEMORY_LIMIT=512M
PROCESSING_CPU_LIMIT=2.0
PROCESSING_MEMORY_LIMIT=4G
ANALYSIS_CPU_LIMIT=0.5
ANALYSIS_MEMORY_LIMIT=512M
WEBSOCKET_CPU_LIMIT=0.3
WEBSOCKET_MEMORY_LIMIT=256M

# Redis
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=1G