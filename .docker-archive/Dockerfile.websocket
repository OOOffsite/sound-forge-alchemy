# WebSocket Service Dockerfile
# Handles real-time communication between frontend and backend services

FROM node:20-alpine AS base

# Install system dependencies and create soundforge user
USER root
RUN apk add --no-cache \
    curl \
    git \
    python3 \
    make \
    g++ && \
    addgroup -g 1001 -S soundforge && \
    adduser -S soundforge -u 1001 -G soundforge

# Set service-specific environment variables
ENV SERVICE_NAME=websocket \
    PORT=3006

# Set working directory
WORKDIR /app

# Copy package files from the websocket service directory
COPY package*.json ./

# Create shared directory and copy shared module (will be mounted as volume in dev)
RUN mkdir -p /app/shared

# Install service-specific dependencies
RUN npm install --force && npm cache clean --force

# Copy TypeScript configuration files
COPY tsconfig*.json ./
COPY nodemon.json ./

# Copy service source code from backend/websocket
COPY src ./src
COPY config ./config

# Create service-specific directories (as root)
RUN mkdir -p \
    /app/logs \
    && chown -R soundforge:soundforge /app

# Switch to soundforge user
USER soundforge

# Health check specific to WebSocket Service
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3006/health || exit 1

# Expose WebSocket Service port
EXPOSE 3006

# Default production command (will use compiled JavaScript)
CMD ["npm", "run", "start"]


# Development stage
FROM base AS development

# Switch to root for development setup
USER root

# Install development dependencies
RUN npm install && npm cache clean --force

# Install development tools globally
RUN npm install -g nodemon typescript ts-node

# Set development permissions
RUN chown -R soundforge:soundforge /app

# Switch back to service user
USER soundforge

# Development environment
ENV NODE_ENV=development

# Development command with TypeScript support
CMD ["npm", "run", "dev"]


# Production stage
FROM base AS production

# Ensure we're using the service user
USER soundforge

# Production environment
ENV NODE_ENV=production

# Production command (using compiled JavaScript)
CMD ["npm", "run", "start"]