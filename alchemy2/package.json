{
  "name": "sound-forge-alchemy2",
  "version": "2.0.0",
  "private": true,
  "description": "Sound Forge Alchemy - Optimized Architecture",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "docker-compose up",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:infrastructure": "cd tests/infrastructure && vitest run --config vitest.config.ts",
    "test:infrastructure:watch": "cd tests/infrastructure && vitest --config vitest.config.ts",
    "test:infrastructure:coverage": "cd tests/infrastructure && vitest run --config vitest.config.ts --coverage",
    "test:e2e": "cd tests/e2e && npm test",
    "clean": "npm run clean --workspaces && docker-compose down -v",
    "lint": "npm run lint --workspaces",
    "type-check": "npm run type-check --workspaces"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "Sound Forge Alchemy Team",
  "license": "MIT"
}
