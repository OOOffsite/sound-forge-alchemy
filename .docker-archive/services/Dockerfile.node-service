# Final optimized Node service Dockerfile
# Properly handles dependencies and module types

FROM node:20-alpine AS base

# Install system dependencies
RUN apk add --no-cache curl git python3 make g++ build-base

# Create non-root user
RUN addgroup -g 1001 -S soundforge && \
    adduser -S soundforge -u 1001 -G soundforge

WORKDIR /app

# Copy package files and install dependencies
COPY package*.json ./
RUN npm ci --only=production && \
    chown -R soundforge:soundforge /app

# Copy source code
COPY --chown=soundforge:soundforge . .

# Switch to non-root user
USER soundforge

# Environment
ENV NODE_ENV=production

# Default command
CMD ["node", "src/index.js"]

# Development stage
FROM base AS development
USER root
RUN npm install
USER soundforge
ENV NODE_ENV=development
CMD ["npx", "nodemon", "--watch", "src", "--watch", "config", "src/index.js"]