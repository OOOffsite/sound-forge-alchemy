# WebSocket Service Dockerfile
# Handles real-time communication between services and frontend

FROM sound-forge-node-base:latest AS base

# Set service-specific environment variables
ENV SERVICE_NAME=websocket-service \
    PORT=3006

# Copy package files for this service
COPY package*.json ./

# Install service-specific dependencies
RUN npm ci && npm cache clean --force

# Copy service source code
COPY --chown=soundforge:soundforge . .

# Health check specific to WebSocket Service
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3006/health || exit 1

# Expose WebSocket Service port
EXPOSE 3006

# Default production command
CMD ["node", "index.js"]


# Development stage
FROM base AS development

# Switch to root for development setup
USER root

# Install development dependencies
RUN npm install && npm cache clean --force

# Install nodemon globally for development
RUN npm install -g nodemon

# Set development permissions
RUN chown -R soundforge:soundforge /app

# Switch back to service user
USER soundforge

# Development environment
ENV NODE_ENV=development

# Development command with auto-reload
CMD ["nodemon", "--watch", ".", "--ignore", "node_modules/", "--ignore", "logs/", "index.js"]


# Production stage
FROM base AS production

# Ensure we're using the service user
USER soundforge

# Production environment
ENV NODE_ENV=production

# Production command
CMD ["node", "index.js"]