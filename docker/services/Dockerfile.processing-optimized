# Optimized Processing Service Dockerfile
# Uses shared python-node-base for ML capabilities

ARG BASE_IMAGE=sound-forge-python-node-base:latest
FROM ${BASE_IMAGE} AS base

# Service-specific configuration
ENV SERVICE_NAME=processing \
    PORT=3003 \
    USE_GPU=false

WORKDIR /app

# Copy service files
COPY --chown=soundforge:soundforge src ./src
COPY --chown=soundforge:soundforge config ./config
COPY --chown=soundforge:soundforge scripts ./scripts

# Download models if needed (cached layer)
RUN mkdir -p /app/models && \
    if [ -f scripts/download-models.sh ]; then \
        chmod +x scripts/download-models.sh && \
        ./scripts/download-models.sh; \
    fi

# Production stage
FROM base AS production
CMD ["node", "src/index.js"]

# Development stage  
FROM base AS development
CMD ["nodemon", "--watch", "src", "--watch", "config", "--watch", "scripts", "src/index.js"]

# GPU-enabled stage
FROM base AS gpu
# Install CUDA runtime (requires nvidia base image in production)
USER root
RUN apk add --no-cache cuda-toolkit || true
USER soundforge

ENV CUDA_VISIBLE_DEVICES=all \
    NVIDIA_VISIBLE_DEVICES=all \
    USE_GPU=true

CMD ["node", "src/index.js"]