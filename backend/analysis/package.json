{
  "name": "analysis",
  "version": "1.0.0",
  "description": "Audio Analysis Service for Sound Forge Alchemy",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "echo 'JavaScript service - no build needed'",
    "install-deps": "cd ../shared && npm install && cd ../analysis && npm install",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write src/**/*.js",
    "format:check": "prettier --check src/**/*.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "axios": "^1.6.7",
    "ioredis": "^5.3.2",
    "winston": "^3.12.0",
    "uuid": "^9.0.1",
    "joi": "^17.12.2",
    "child_process": "^1.0.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  }
}